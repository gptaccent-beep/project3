# Generate with: node scripts/hash-password.mjs "your-long-password"
ADMIN_USERNAME=your_admin_username
ADMIN_PASSWORD_HASH=scrypt:replace_with_generated_hash
ADMIN_SESSION_SECRET=replace_with_at_least_32_random_characters
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Required for persistent admin saves on Vercel (created by Vercel Blob integration)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
